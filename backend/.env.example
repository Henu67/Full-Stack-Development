# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

PORT=5000

# MongoDB Atlas connection string (mongodb+srv://<user>:<password>@<cluster>/<db>?...)
MONGODB_URI=

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (your Vite dev server, deployed frontend, etc.)
CLIENT_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=